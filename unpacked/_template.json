 U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n</style>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; height: 100%; background: #0A070F; color: #fff; font-family: 'Inter', system-ui, sans-serif; overscroll-behavior: none; }\n  body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; overflow: auto; background:\n    radial-gradient(60% 40% at 20% 10%, rgba(155,59,255,0.12), transparent 60%),\n    radial-gradient(50% 40% at 80% 90%, rgba(255,107,74,0.1), transparent 60%),\n    #0A070F;\n  }\n  input[type=range] { -webkit-appearance: none; background: rgba(255,255,255,0.08); height: 4px; border-radius: 2px; outline: none; }\n  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #fff; cursor: pointer; box-shadow: 0 0 0 3px rgba(255,59,107,0.25); }\n  ::-webkit-scrollbar { width: 0; height: 0; }\n  /* Tweaks panel */\n  .tweaks-panel { position: fixed; bottom: 20px; right: 20px; z-index: 1000;\n    background: rgba(20,10,30,0.95); backdrop-filter: blur(16px);\n    border: 1px solid rgba(255,255,255,0.1); border-radius: 18px;\n    padding: 16px; width: 260px; color: #fff;\n    font-family: 'Inter'; font-size: 13px;\n    box-shadow: 0 20px 50px rgba(0,0,0,0.5);\n    display: none;\n  }\n  .tweaks-panel.open { display: block; }\n  .tweaks-panel h3 { margin: 0 0 12px; font-family: 'Space Grotesk'; font-size: 14px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.65); }\n  .tweak-row { margin-bottom: 12px; }\n  .tweak-row label { display: block; margin-bottom: 5px; font-size: 11px; color: rgba(255,255,255,0.55); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; }\n  .tweak-opts { display: flex; gap: 4px; flex-wrap: wrap; }\n  .tweak-opt { padding: 6px 10px; border-radius: 8px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); font-size: 11px; cursor: pointer; font-weight: 600; }\n  .tweak-opt.active { background: linear-gradient(135deg,#FF6B4A,#9B3BFF); color: #fff; border-color: transparent; }\n  .shell-wrap { display: flex; flex-direction: column; align-items: center; gap: 20px; }\n  .shell-meta { font-family: 'Space Grotesk'; font-size: 13px; color: rgba(255,255,255,0.55); text-align: center; letter-spacing: 2px; text-transform: uppercase; }\n</style>\n</head>\n<body>\n<div id=\"root\" class=\"shell-wrap\"></div>\n\n<script src=\"b03a0d7b-ab7c-4ccc-bc3c-ccb631016dda\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"></script>\n<script src=\"57f4541b-2c4b-49ac-915c-24b473263e21\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"></script>\n<script src=\"f8982dd0-bd6b-45f7-b33a-171af55fe405\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"></script>\n\n<script type=\"text/babel\" src=\"7f7022ff-d339-4fd7-89fc-8d4ddd3aa901\"></script>\n<script type=\"text/babel\" src=\"347c1784-297a-4a5e-b1b7-4e000047ed71\"></script>\n<script type=\"text/babel\" src=\"4034ed3b-6a6b-4611-9e51-96f7b8025354\"></script>\n<script type=\"text/babel\" src=\"d241b439-39b0-4ac3-aabe-0fa1f32d119e\"></script>\n<script type=\"text/babel\" src=\"1019bc81-595d-4547-8de0-52ee7d28995e\"></script>\n<script type=\"text/babel\" src=\"f534e02b-eb5f-4cb3-bc41-e800aeb7b474\"></script>\n<script type=\"text/babel\" src=\"acddfa31-80a9-43fc-8684-3d54bc16aee5\"></script>\n<script type=\"text/babel\" src=\"e3998cdf-0f15-4508-abb2-56fcef9c8da5\"></script>\n\n<script type=\"text/babel\" data-presets=\"env,react\">\n\n// ─── TWEAKS ───────────────────────────────────────────────\nconst TWEAKS = /*EDITMODE-BEGIN*/{\n  \"startScreen\": \"splash\",\n  \"accentTheme\": \"flame\",\n  \"posterStyle\": \"generative\",\n  \"matchCelebration\": \"confetti\",\n  \"density\": \"cozy\"\n}/*EDITMODE-END*/;\n\n// ─── APP ──────────────────────────────────────────────────\nconst INITIAL_ROOM = {\n  code: 'FLCK42',\n  members: [\n    { name: 'You',   avatar: 'A', color: 'linear-gradient(135deg,#FF6B4A,#FF3B6B)', host: true,  ready: true,  status: 'Ready' },\n    { name: 'Rae',   avatar: 'R', color: 'linear-gradient(135deg,#9B3BFF,#5B1DB5)', host: false, ready: true,  status: 'Ready' },\n    { name: 'Mika',  avatar: 'M', color: 'linear-gradient(135deg,#4EFFD6,#0EA5A0)', host: false, ready: false, status: 'Tapping in…' },\n  ],\n  matches: [],\n};\n\nconst DEFAULT_FILTERS = {\n  type: 'All',\n  genres: [],\n  platforms: [],\n  yearRange: [2018, 2026],\n};\n\nfunction App() {\n  // Persist screen so refresh keeps position\n  const [screen, setScreen] = React.useState(() => {\n    return localStorage.getItem('fp_screen') || TWEAKS.startScreen || 'splash';\n  });\n  React.useEffect(() => { localStorage.setItem('fp_screen', screen); }, [screen]);\n\n  const [user, setUser] = React.useState({ name: 'Alex', email: 'alex@flickpick.app', avatar: 'A' });\n  const [room, setRoom] = React.useState(INITIAL_ROOM);\n  const [queue, setQueue] = React.useState(FP_MOVIES);\n  const [matches, setMatches] = React.useState([\n    { ...FP_MOVIES[2], watched: false, matchedAt: 'Yesterday' },\n    { ...FP_MOVIES[5], watched: true,  matchedAt: 'Last week' },\n  ]);\n  const [filters, setFilters] = React.useState(DEFAULT_FILTERS);\n  const [showFilters, setShowFilters] = React.useState(false);\n  const [matchMovie, setMatchMovie] = React.useState(null);\n\n  const handleMatch = (movie) => {\n    setMatches(ms => [{ ...movie, watched: false, matchedAt: 'Just now' }, ...ms]);\n    setMatchMovie(movie);\n    setScreen('match');\n  };\n\n  const go = (s) => setScreen(s);\n\n  // Apply \"density\" tweak via root font-size or gap — here via body data attr\n  React.useEffect(() => {\n    document.body.dataset.density = TWEAKS.density;\n  }, []);\n\n  let screenEl;\n  switch (screen) {\n    case 'splash':\n      screenEl = <SplashScreen onDone={() => go('welcome')}/>;\n      break;\n    case 'welcome':\n      screenEl = <WelcomeScreen\n        onSignIn={() => go('signin')}\n        onEmail={() => go('signup')}/>;\n      break;\n    case 'signin':\n      screenEl = <SignInScreen mode=\"signin\" onBack={() => go('welcome')} onComplete={() => go('home')}/>;\n      break;\n    case 'signup':\n      screenEl = <SignInScreen mode=\"signup\" onBack={() => go('welcome')} onComplete={() => go('home')}/>;\n      break;\n    case 'home':\n      screenEl = <HomeScreen\n        user={user}\n        activeRoom={matches.length > 0 ? { ...room, matches } : null}\n        onCreateRoom={() => go('lobby')}\n        onJoinRoom={() => go('join')}\n        onResumeRoom={() => go('swipe')}\n        onOpenHistory={() => go('history')}\n        onOpenProfile={() => go('profile')}/>;\n      break;\n    case 'lobby':\n      screenEl = <RoomLobby room={room} onLeave={() => go('home')} onStart={() => go('swipe')}/>;\n      break;\n    case 'join':\n      screenEl = <JoinRoomScreen onBack={() => go('home')} onJoin={(code) => {\n        setRoom(r => ({ ...r, code }));\n        go('lobby');\n      }}/>;\n      break;\n    case 'swipe':\n      screenEl = <>\n        <SwipeScreen\n          room={room}\n          queue={queue}\n          setQueue={setQueue}\n          matches={matches}\n          filters={filters}\n          onBack={() => go('home')}\n          onMatch={handleMatch}\n          onOpenFilters={() => setShowFilters(true)}\n          onOpenHistory={() => go('history')}/>\n        {showFilters && <FiltersSheet filters={filters} setFilters={setFilters} onClose={() => setShowFilters(false)}/>}\n      </>;\n      break;\n    case 'match':\n      screenEl = <MatchScreen\n        movie={matchMovie || FP_MOVIES[0]}\n        users={room.members.slice(0, 2)}\n        onKeep={() => go('swipe')}\n        onOpen={() => go('history')}/>;\n      break;\n    case 'history':\n      screenEl = <HistoryScreen\n        onBack={() => go('home')}\n        matches={matches}\n        onToggleWatched={(id) => setMatches(ms => ms.map(m => m.id === id ? { ...m, watched: !m.watched } : m))}\n        onRemove={(id) => setMatches(ms => ms.filter(m => m.id !== id))}/>;\n      break;\n    case 'profile':\n      screenEl = <ProfileScreen onBack={() => go('home')} user={user} onSignOut={() => go('welcome')}/>;\n      break;\n    default:\n      screenEl = <SplashScreen onDone={() => go('welcome')}/>;\n  }\n\n  const screenLabels = {\n    splash: '01 Splash', welcome: '02 Welcome', signin: '03 Sign in', signup: '03 Sign up',\n    home: '04 Home', lobby: '05 Room lobby', join: '06 Join room', swipe: '07 Swipe',\n    match: '08 Match', history: '09 History', profile: '10 Profile',\n  };\n\n  return (\n    <>\n      <IOSDevice dark={true} width={390} height={844}>\n        <div data-screen-label={screenLabels[screen]} style={{ position: 'relative', width: '100%', height: '100%', overflow: 'hidden' }}>\n          {screenEl}\n        </div>\n      </IOSDevice>\n      <NavChrome screen={screen} setScreen={setScreen}/>\n    </>\n  );\n}\n\n// A subtle bottom dock so users can jump screens for review\nfunction NavChrome({ screen, setScreen }) {\n  const screens = [\n    ['splash','Splash'],['welcome','Welcome'],['signup','Sign up'],['home','Home'],\n    ['lobby','Lobby'],['join','Join'],['swipe','Swipe'],['history','History'],['profile','Profile'],\n  ];\n  return (\n    <div style={{\n      display: 'flex', gap: 6, flexWrap: 'wrap', justifyContent: 'center',\n      maxWidth: 520,\n    }}>\n      {screens.map(([k, l]) => (\n        <button key={k} onClick={() => setScreen(k)} style={{\n          padding: '6px 12px', borderRadius: 999,\n          background: screen === k ? 'linear-gradient(135deg,#FF6B4A,#9B3BFF)' : 'rgba(255,255,255,0.05)',\n          border: '1px solid rgba(255,255,255,0.08)',\n          color: '#fff', fontSize: 11, fontWeight: 600, cursor: 'pointer',\n          fontFamily: 'Inter',\n        }}>{l}</button>\n      ))}\n    </div>\n  );\n}\n\nReactDOM.createRoot(document.getElementById('root')).render(<App/>);\n\n// ─── TWEAKS host integration ─────────────────────────────\n(function initTweaks() {\n  // Build a floating panel\n  const panel = document.createElement('div');\n  panel.className = 'tweaks-panel';\n  panel.innerHTML = `\n    <h3>Tweaks</h3>\n    <div class=\"tweak-row\">\n      <label>Start screen</label>\n      <div class=\"tweak-opts\" id=\"tw-start\">\n        ${['splash','welcome','home','swipe'].map(v => `<button class=\"tweak-opt\" data-k=\"startScreen\" data-v=\"${v}\">${v}</button>`).join('')}\n      </div>\n    </div>\n    <div class=\"tweak-row\">\n      <label>Accent</label>\n      <div class=\"tweak-opts\">\n        ${['flame','violet','electric'].map(v => `<button class=\"tweak-opt\" data-k=\"accentTheme\" data-v=\"${v}\">${v}</button>`).join('')}\n      </div>\n    </div>\n    <div class=\"tweak-row\">\n      <label>Match celebration</label>\n      <div class=\"tweak-opts\">\n        ${['confetti','minimal','ring'].map(v => `<button class=\"tweak-opt\" data-k=\"matchCelebration\" data-v=\"${v}\">${v}</button>`).join('')}\n      </div>\n    </div>\n    <div class=\"tweak-row\">\n      <label>Density</label>\n      <div class=\"tweak-opts\">\n        ${['cozy','compact'].map(v => `<button class=\"tweak-opt\" data-k=\"density\" data-v=\"${v}\">${v}</button>`).join('')}\n      </div>\n    </div>\n  `;\n  document.body.appendChild(panel);\n\n  const syncActive = () => {\n    panel.querySelectorAll('.tweak-opt').forEach(b => {\n      b.classList.toggle('active', TWEAKS[b.dataset.k] === b.dataset.v);\n    });\n  };\n  syncActive();\n\n  panel.addEventListener('click', (e) => {\n    const b = e.target.closest('.tweak-opt');\n    if (!b) return;\n    TWEAKS[b.dataset.k] = b.dataset.v;\n    syncActive();\n    applyTweaks();\n    window.parent.postMessage({ type: '__edit_mode_set_keys', edits: { [b.dataset.k]: b.dataset.v } }, '*');\n  });\n\n  function applyTweaks() {\n    // accent theme adjusts --fp-flame on body via data attr\n    document.body.dataset.accent = TWEAKS.accentTheme;\n    document.body.dataset.celebration = TWEAKS.matchCelebration;\n    // respect startScreen on next fresh-load only\n  }\n  applyTweaks();\n\n  window.addEventListener('message', (e) => {\n    if (e.data?.type === '__activate_edit_mode') panel.classList.add('open');\n    if (e.data?.type === '__deactivate_edit_mode') panel.classList.remove('open');\n  });\n  window.parent.postMessage({ type: '__edit_mode_available' }, '*');\n})();\n\n// Accent swaps: override flame gradient via CSS var cascade\nconst style = document.createElement('style');\nstyle.textContent = `\n  body[data-accent=\"violet\"] { --fp-accent-override: 1; }\n  body[data-accent=\"electric\"] { --fp-accent-override: 1; }\n`;\ndocument.head.appendChild(style);\n\n</script>\n\n\n\n</body></html>"