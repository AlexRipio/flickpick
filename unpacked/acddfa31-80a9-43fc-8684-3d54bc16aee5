// Home / Rooms screens — after sign-in

function HomeScreen({ user, onCreateRoom, onJoinRoom, onOpenHistory, onOpenProfile, activeRoom, onResumeRoom }) {
  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
      <AmbientBackdrop hue={290}/>
      <div style={{ position: 'relative', zIndex: 2, padding: '8px 24px 100px', flex: 1, overflow: 'auto' }}>
        {/* header */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 28 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
            <FlameLogoImage size={30}/>
            <FlickPickWordmark height={19}/>
          </div>
          <button onClick={onOpenProfile} style={{
            width: 38, height: 38, borderRadius: 999,
            border: '1.5px solid rgba(255,255,255,0.15)',
            background: 'linear-gradient(135deg, #FF6B4A, #9B3BFF)',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            color: '#fff', fontWeight: 700, fontSize: 14,
            cursor: 'pointer', padding: 0,
          }}>{user.avatar}</button>
        </div>

        {/* greeting */}
        <div style={{ marginBottom: 24 }}>
          <div style={{ fontSize: 13, color: FP.textMuted, letterSpacing: 2, textTransform: 'uppercase', marginBottom: 8 }}>
            Tonight
          </div>
          <h1 style={{
            fontFamily: '"Space Grotesk", system-ui',
            fontSize: 34, fontWeight: 800, color: FP.text,
            margin: 0, letterSpacing: -1, lineHeight: 1.05,
          }}>
            Hey {user.name},<br/>
            <span style={{ color: FP.textDim, fontWeight: 600 }}>what are you in the mood for?</span>
          </h1>
        </div>

        {/* resume room card (if active) */}
        {activeRoom && (
          <div onClick={onResumeRoom} style={{
            background: FP.flame, borderRadius: 22, padding: 18,
            marginBottom: 20, cursor: 'pointer',
            boxShadow: '0 12px 30px rgba(255,59,107,0.3)',
            display: 'flex', alignItems: 'center', gap: 14,
          }}>
            <div style={{
              width: 48, height: 48, borderRadius: 14,
              background: 'rgba(255,255,255,0.2)',
              display: 'flex', alignItems: 'center', justifyContent: 'center',
              backdropFilter: 'blur(10px)',
            }}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 11, fontWeight: 700, color: 'rgba(255,255,255,0.85)', letterSpacing: 1.5, textTransform: 'uppercase' }}>
                Pick up where you left off
              </div>
              <div style={{ fontSize: 17, fontWeight: 700, color: '#fff', marginTop: 2 }}>
                Room · {activeRoom.code}
              </div>
              <div style={{ fontSize: 12, color: 'rgba(255,255,255,0.85)', marginTop: 2 }}>
                {activeRoom.members.length} swiping · {activeRoom.matches.length} matches
              </div>
            </div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
              <path d="M9 6l6 6-6 6"/>
            </svg>
          </div>
        )}

        {/* action cards */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
          <ActionCard
            onClick={onCreateRoom}
            title="Create a room"
            subtitle="Invite a partner, friends, or a group"
            gradient="linear-gradient(135deg, #8B5CF6 0%, #5B1DB5 100%)"
            icon={<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="#fff" strokeWidth="2.5" strokeLinecap="round"/></svg>}
          />
          <ActionCard
            onClick={onJoinRoom}
            title="Join with code"
            subtitle="Got a 6-letter invite? Drop it in."
            gradient="rgba(255,255,255,0.05)"
            border="1px solid rgba(255,255,255,0.1)"
            icon={<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M14 3h7v7M10 21H3v-7M21 3l-8 8M3 21l8-8" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/></svg>}
          />
        </div>

        {/* trending row */}
        <div style={{ marginTop: 32 }}>
          <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', marginBottom: 14 }}>
            <div style={{
              fontFamily: '"Space Grotesk", system-ui',
              fontSize: 18, fontWeight: 700, color: FP.text,
            }}>Trending this week</div>
            <div style={{ fontSize: 13, color: FP.flameSolid, fontWeight: 600 }}>See all</div>
          </div>
          <div style={{
            display: 'flex', gap: 12, overflowX: 'auto',
            margin: '0 -24px', padding: '0 24px 4px',
            scrollbarWidth: 'none',
          }}>
            {FP_MOVIES.slice(0, 8).map(m => (
              <div key={m.id} style={{
                width: 128, height: 190, borderRadius: 16,
                overflow: 'hidden', position: 'relative', flexShrink: 0,
                boxShadow: '0 10px 22px rgba(0,0,0,0.4)',
              }}>
                <Poster movie={m} showBadge={false}/>
                <div style={{
                  position: 'absolute', left: 0, right: 0, bottom: 0,
                  padding: '24px 10px 10px',
                  background: 'linear-gradient(180deg, transparent, rgba(0,0,0,0.9))',
                  fontSize: 12, fontWeight: 700, color: '#fff',
                }}>{m.title}</div>
              </div>
            ))}
          </div>
        </div>

        {/* history peek */}
        <div onClick={onOpenHistory} style={{
          marginTop: 28, padding: '16px 18px',
          borderRadius: 20,
          background: 'rgba(255,255,255,0.04)',
          border: '1px solid rgba(255,255,255,0.08)',
          display: 'flex', alignItems: 'center', gap: 12, cursor: 'pointer',
        }}>
          <div style={{
            width: 38, height: 38, borderRadius: 12,
            background: 'rgba(78,255,214,0.12)',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
          }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M20.8 11a9 9 0 11-2.9-7.6M21 3v5h-5" stroke="#4EFFD6" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
            </svg>
          </div>
          <div style={{ flex: 1 }}>
            <div style={{ fontSize: 15, fontWeight: 700, color: FP.text }}>Your match history</div>
            <div style={{ fontSize: 12, color: FP.textDim, marginTop: 2 }}>12 titles across 4 rooms</div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="rgba(255,255,255,0.4)">
            <path d="M9 6l6 6-6 6"/>
          </svg>
        </div>
      </div>
    </div>
  );
}

function ActionCard({ onClick, title, subtitle, gradient, border, icon }) {
  return (
    <div onClick={onClick} style={{
      padding: '18px 20px', borderRadius: 22,
      background: gradient, border: border || 'none',
      display: 'flex', alignItems: 'center', gap: 14,
      cursor: 'pointer', position: 'relative', overflow: 'hidden',
      boxShadow: gradient.includes('8B5CF6') ? '0 12px 28px rgba(139,92,246,0.3)' : 'none',
    }}>
      <div style={{
        width: 52, height: 52, borderRadius: 16,
        background: 'rgba(255,255,255,0.15)',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        backdropFilter: 'blur(10px)', flexShrink: 0,
      }}>{icon}</div>
      <div style={{ flex: 1 }}>
        <div style={{ fontSize: 17, fontWeight: 700, color: '#fff' }}>{title}</div>
        <div style={{ fontSize: 13, color: 'rgba(255,255,255,0.75)', marginTop: 2 }}>{subtitle}</div>
      </div>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="rgba(255,255,255,0.6)">
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </div>
  );
}

// Room-waiting room lobby (after create)
function RoomLobby({ room, onStart, onLeave, onCopyCode }) {
  const [copied, setCopied] = React.useState(false);
  const copy = () => {
    onCopyCode?.();
    setCopied(true);
    setTimeout(() => setCopied(false), 1600);
  };
  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column' }}>
      <AmbientBackdrop hue={260}/>
      {/* header */}
      <div style={{
        position: 'relative', zIndex: 2,
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        padding: '16px 20px',
      }}>
        <IconButton onClick={onLeave} size={42}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M9 2L3 7l6 5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </IconButton>
        <div style={{ fontSize: 13, fontWeight: 600, color: FP.textDim }}>
          Room lobby
        </div>
        <div style={{ width: 42 }}/>
      </div>
      {/* body */}
      <div style={{
        position: 'relative', zIndex: 2, flex: 1,
        padding: '10px 24px 28px', display: 'flex', flexDirection: 'column', gap: 20,
      }}>
        {/* code card */}
        <div style={{
          background: 'rgba(255,255,255,0.04)',
          border: '1px solid rgba(255,255,255,0.08)',
          borderRadius: 26, padding: 22, textAlign: 'center',
        }}>
          <div style={{ fontSize: 11, color: FP.textMuted, letterSpacing: 2.5, textTransform: 'uppercase', marginBottom: 10 }}>
            Invite code
          </div>
          <div style={{
            fontFamily: '"Space Grotesk", monospace',
            fontSize: 44, fontWeight: 800, letterSpacing: 8,
            background: FP.flame,
            WebkitBackgroundClip: 'text',
            WebkitTextFillColor: 'transparent',
            lineHeight: 1,
          }}>{room.code}</div>
          <button onClick={copy} style={{
            marginTop: 16,
            padding: '10px 18px', borderRadius: 999,
            background: 'rgba(255,255,255,0.08)',
            border: '1px solid rgba(255,255,255,0.12)',
            color: '#fff', fontSize: 13, fontWeight: 600, cursor: 'pointer',
            display: 'inline-flex', alignItems: 'center', gap: 8,
          }}>
            {copied ? (
              <>
                <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="#4EFFD6" strokeWidth="2" fill="none" strokeLinecap="round" strokeLinejoin="round"/></svg>
                <span style={{ color: '#4EFFD6' }}>Copied</span>
              </>
            ) : (
              <>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="9" y="9" width="11" height="11" rx="2" stroke="#fff" strokeWidth="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="#fff" strokeWidth="2" strokeLinecap="round"/></svg>
                Copy code
              </>
            )}
          </button>
        </div>

        {/* members */}
        <div>
          <div style={{ fontSize: 12, color: FP.textDim, letterSpacing: 2, textTransform: 'uppercase', marginBottom: 12 }}>
            In the room · {room.members.length}
          </div>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
            {room.members.map((m, i) => (
              <div key={i} style={{
                display: 'flex', alignItems: 'center', gap: 12,
                padding: '12px 14px', borderRadius: 18,
                background: 'rgba(255,255,255,0.04)',
                border: '1px solid rgba(255,255,255,0.08)',
              }}>
                <div style={{
                  width: 40, height: 40, borderRadius: 999,
                  background: m.color, color: '#fff',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  fontWeight: 700, fontSize: 14,
                }}>{m.avatar}</div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 15, fontWeight: 600, color: FP.text }}>{m.name}{m.host && <span style={{ color: FP.flameSolid, fontSize: 11, marginLeft: 8, fontWeight: 700 }}>HOST</span>}</div>
                  <div style={{ fontSize: 12, color: FP.textDim }}>{m.status}</div>
                </div>
                <div style={{
                  width: 8, height: 8, borderRadius: 999,
                  background: m.ready ? '#4EFFD6' : '#FFB547',
                  boxShadow: `0 0 12px ${m.ready ? '#4EFFD6' : '#FFB547'}`,
                }}/>
              </div>
            ))}
            {/* waiting slot */}
            <div style={{
              display: 'flex', alignItems: 'center', gap: 12,
              padding: '12px 14px', borderRadius: 18,
              border: '1px dashed rgba(255,255,255,0.15)',
            }}>
              <div style={{
                width: 40, height: 40, borderRadius: 999,
                background: 'rgba(255,255,255,0.05)',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                color: FP.textMuted,
              }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" strokeWidth="2" strokeLinecap="round"/>
                </svg>
              </div>
              <div style={{ fontSize: 14, color: FP.textDim }}>Waiting for more to join…</div>
            </div>
          </div>
        </div>

        <div style={{ flex: 1 }}/>

        <GradientButton variant="flame" onClick={onStart}>
          Start swiping
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M9 6l6 6-6 6"/></svg>
        </GradientButton>
      </div>
    </div>
  );
}

function JoinRoomScreen({ onBack, onJoin }) {
  const [code, setCode] = React.useState('');
  const filled = code.padEnd(6, ' ').split('');
  const tap = (c) => {
    if (code.length < 6 && /[A-Z0-9]/.test(c)) setCode(code + c);
  };
  const del = () => setCode(code.slice(0, -1));
  const canJoin = code.length === 6;

  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column' }}>
      <AmbientBackdrop hue={320}/>
      <div style={{ position: 'relative', zIndex: 2, padding: '16px 20px' }}>
        <IconButton onClick={onBack} size={42}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M9 2L3 7l6 5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </IconButton>
      </div>
      <div style={{ position: 'relative', zIndex: 2, padding: '20px 24px', flex: 1, display: 'flex', flexDirection: 'column' }}>
        <h1 style={{
          fontFamily: '"Space Grotesk", system-ui',
          fontSize: 32, fontWeight: 800, color: FP.text,
          margin: 0, letterSpacing: -0.8,
        }}>Join a room</h1>
        <p style={{ fontSize: 15, color: FP.textDim, margin: '8px 0 32px' }}>
          Enter the 6-character code your friend shared.
        </p>

        {/* digits */}
        <div style={{ display: 'flex', gap: 8, justifyContent: 'center', marginBottom: 28 }}>
          {filled.map((c, i) => (
            <div key={i} style={{
              width: 44, height: 56, borderRadius: 14,
              background: c.trim() ? FP.flame : 'rgba(255,255,255,0.04)',
              border: c.trim() ? 'none' : `1px solid ${i === code.length ? '#FF3B6B' : 'rgba(255,255,255,0.1)'}`,
              display: 'flex', alignItems: 'center', justifyContent: 'center',
              fontFamily: '"Space Grotesk", monospace',
              fontSize: 26, fontWeight: 800,
              color: '#fff',
              boxShadow: c.trim() ? '0 6px 18px rgba(255,59,107,0.3)' : 'none',
            }}>{c.trim() || ''}</div>
          ))}
        </div>

        <div style={{ flex: 1 }}/>

        {/* custom keypad */}
        <div style={{
          display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)',
          gap: 10, marginBottom: 14,
        }}>
          {['Q','W','E','R','T','Y','U','I','O','P','A','S','D','F','G','H','J','K','L','Z','X','C','V','B','N','M','1','2','3','4','5','6','7','8','9','0'].slice(0,12).map(c => (
            <button key={c} onClick={() => tap(c)} style={{
              height: 48, borderRadius: 14,
              background: 'rgba(255,255,255,0.06)',
              border: '1px solid rgba(255,255,255,0.08)',
              color: FP.text, fontSize: 18, fontWeight: 700, cursor: 'pointer',
              fontFamily: '"Space Grotesk", monospace',
            }}>{c}</button>
          ))}
        </div>
        <div style={{ display: 'flex', gap: 10, marginBottom: 18 }}>
          <button onClick={del} style={{
            flex: 1, height: 48, borderRadius: 14,
            background: 'rgba(255,255,255,0.06)',
            border: '1px solid rgba(255,255,255,0.08)',
            color: FP.textDim, fontSize: 14, fontWeight: 600, cursor: 'pointer',
          }}>⌫ Delete</button>
          <button onClick={() => setCode('')} style={{
            flex: 1, height: 48, borderRadius: 14,
            background: 'rgba(255,255,255,0.06)',
            border: '1px solid rgba(255,255,255,0.08)',
            color: FP.textDim, fontSize: 14, fontWeight: 600, cursor: 'pointer',
          }}>Clear</button>
        </div>
        <GradientButton variant="flame" disabled={!canJoin} onClick={canJoin ? () => onJoin(code) : undefined}>
          Join room
        </GradientButton>
      </div>
    </div>
  );
}

Object.assign(window, { HomeScreen, RoomLobby, JoinRoomScreen });
