// Filters bottom sheet
function FiltersSheet({ filters, setFilters, onClose }) {
  const [draft, setDraft] = React.useState(filters);
  const apply = () => { setFilters(draft); onClose(); };
  const types = ['All', 'Movie', 'Series'];
  const allGenres = ['Action','Comedy','Romance','Drama','Thriller','Horror','Sci-Fi','Fantasy','Crime','Mystery'];
  const allPlatforms = ['Netflix','Prime','HBO','Apple TV','Shudder'];

  return (
    <div style={{ position: 'absolute', inset: 0, zIndex: 50 }}>
      <div onClick={onClose} style={{
        position: 'absolute', inset: 0, background: 'rgba(0,0,0,0.6)',
        backdropFilter: 'blur(4px)',
        animation: 'fp-fade-in 0.2s ease-out',
      }}/>
      <div style={{
        position: 'absolute', left: 0, right: 0, bottom: 0,
        background: 'linear-gradient(180deg, #1A0F2E 0%, #0B0618 100%)',
        borderTopLeftRadius: 32, borderTopRightRadius: 32,
        border: '1px solid rgba(255,255,255,0.08)',
        padding: '14px 22px 28px',
        maxHeight: '88%', overflowY: 'auto',
        animation: 'fp-slide-up 0.3s cubic-bezier(.2,.8,.3,1)',
      }}>
        <div style={{
          width: 40, height: 4, borderRadius: 2, background: 'rgba(255,255,255,0.2)',
          margin: '0 auto 16px',
        }}/>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
          <div style={{
            fontFamily: '"Space Grotesk"', fontSize: 22, fontWeight: 800, color: FP.text,
          }}>Fine-tune the queue</div>
          <button onClick={() => setDraft({ type: 'All', genres: [], platforms: [], yearRange: [1990, 2026] })}
            style={{ background: 'transparent', border: 'none', color: FP.flameSolid, fontSize: 13, fontWeight: 700, cursor: 'pointer' }}>
            Reset
          </button>
        </div>

        <Section title="Type">
          <div style={{ display: 'flex', gap: 8 }}>
            {types.map(t => (
              <button key={t} onClick={() => setDraft({ ...draft, type: t })} style={{
                flex: 1, height: 44, borderRadius: 14,
                border: 'none',
                background: draft.type === t ? FP.flame : 'rgba(255,255,255,0.05)',
                color: '#fff', fontWeight: 700, fontSize: 14, cursor: 'pointer',
                boxShadow: draft.type === t ? '0 6px 18px rgba(255,59,107,0.3)' : 'none',
              }}>{t}</button>
            ))}
          </div>
        </Section>

        <Section title="Genre">
          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
            {allGenres.map(g => (
              <Chip key={g} active={draft.genres.includes(g)}
                onClick={() => setDraft({
                  ...draft,
                  genres: draft.genres.includes(g)
                    ? draft.genres.filter(x => x !== g)
                    : [...draft.genres, g],
                })}>{g}</Chip>
            ))}
          </div>
        </Section>

        <Section title="Streaming platform">
          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
            {allPlatforms.map(p => (
              <Chip key={p} active={draft.platforms.includes(p)}
                onClick={() => setDraft({
                  ...draft,
                  platforms: draft.platforms.includes(p)
                    ? draft.platforms.filter(x => x !== p)
                    : [...draft.platforms, p],
                })}>{p}</Chip>
            ))}
          </div>
        </Section>

        <Section title={`Release year · ${draft.yearRange[0]}–${draft.yearRange[1]}`}>
          <div style={{ display: 'flex', gap: 12 }}>
            <input type="range" min="1990" max="2026" value={draft.yearRange[0]}
              onChange={(e) => setDraft({ ...draft, yearRange: [Math.min(+e.target.value, draft.yearRange[1]), draft.yearRange[1]] })}
              style={{ flex: 1, accentColor: '#FF3B6B' }}/>
            <input type="range" min="1990" max="2026" value={draft.yearRange[1]}
              onChange={(e) => setDraft({ ...draft, yearRange: [draft.yearRange[0], Math.max(+e.target.value, draft.yearRange[0])] })}
              style={{ flex: 1, accentColor: '#FF3B6B' }}/>
          </div>
        </Section>

        <GradientButton variant="flame" onClick={apply} style={{ marginTop: 10 }}>
          Apply filters
        </GradientButton>
      </div>
      <style>{`
        @keyframes fp-slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
        @keyframes fp-fade-in { from { opacity: 0; } to { opacity: 1; } }
      `}</style>
    </div>
  );
}

function Section({ title, children }) {
  return (
    <div style={{ marginBottom: 22 }}>
      <div style={{
        fontSize: 12, fontWeight: 700, color: FP.textDim,
        letterSpacing: 1.5, textTransform: 'uppercase', marginBottom: 10,
      }}>{title}</div>
      {children}
    </div>
  );
}

// Match History
function HistoryScreen({ onBack, matches, onToggleWatched, onRemove }) {
  const [tab, setTab] = React.useState('all');
  const filtered = tab === 'all' ? matches : matches.filter(m => m.watched);
  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column' }}>
      <AmbientBackdrop hue={260}/>
      <div style={{ position: 'relative', zIndex: 2, padding: '16px 20px 0', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <IconButton onClick={onBack} size={40}>
