// Detail sheet - opens on tap of a swipe card
function DetailSheet({ movie, onClose, onLike, onSkip }) {
  const [show, setShow] = React.useState(false);
  React.useEffect(() => {
    const t = setTimeout(() => setShow(true), 20);
    return () => clearTimeout(t);
  }, []);
  const close = () => {
    setShow(false);
    setTimeout(onClose, 220);
  };
  return (
    <div style={{ position: 'absolute', inset: 0, zIndex: 60 }}>
      {/* scrim */}
      <div onClick={close} style={{
        position: 'absolute', inset: 0,
        background: 'rgba(0,0,0,0.65)',
        backdropFilter: 'blur(6px)',
        WebkitBackdropFilter: 'blur(6px)',
        opacity: show ? 1 : 0,
        transition: 'opacity 0.22s',
      }}/>
      {/* sheet */}
      <div style={{
        position: 'absolute', left: 0, right: 0, bottom: 0,
        borderTopLeftRadius: 32, borderTopRightRadius: 32,
        background: 'linear-gradient(180deg, #1A0F2E 0%, #0B0618 100%)',
        border: '1px solid rgba(255,255,255,0.08)',
        maxHeight: '92%',
        transform: show ? 'translateY(0)' : 'translateY(100%)',
        transition: 'transform 0.32s cubic-bezier(.2,.8,.3,1)',
        display: 'flex', flexDirection: 'column',
        overflow: 'hidden',
      }}>
        {/* hero poster */}
        <div style={{ position: 'relative', height: 280, flexShrink: 0 }}>
          <Poster movie={movie} showBadge={false}/>
          <div style={{
            position: 'absolute', inset: 0,
            background: 'linear-gradient(180deg, transparent 30%, rgba(11,6,24,0.95) 100%)',
          }}/>
          {/* grabber */}
          <div style={{
            position: 'absolute', top: 10, left: '50%', transform: 'translateX(-50%)',
            width: 44, height: 4, borderRadius: 2, background: 'rgba(255,255,255,0.35)',
          }}/>
          {/* close */}
          <button onClick={close} style={{
            position: 'absolute', top: 16, right: 16,
            width: 34, height: 34, borderRadius: 999,
            background: 'rgba(0,0,0,0.5)', border: '1px solid rgba(255,255,255,0.15)',
            backdropFilter: 'blur(10px)',
            color: '#fff', cursor: 'pointer', padding: 0,
            display: 'flex', alignItems: 'center', justifyContent: 'center',
          }}>
            <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 2l8 8M10 2l-8 8" stroke="#fff" strokeWidth="2" strokeLinecap="round"/></svg>
          </button>
          {/* type + rating */}
          <div style={{ position: 'absolute', top: 16, left: 16, display: 'flex', gap: 6 }}>
            <span style={{
              padding: '4px 9px', borderRadius: 999,
              fontSize: 10, fontWeight: 700, letterSpacing: 1.2, textTransform: 'uppercase',
              background: 'rgba(0,0,0,0.55)', color: '#fff',
              border: '0.5px solid rgba(255,255,255,0.25)',
              backdropFilter: 'blur(8px)',
            }}>{movie.type}</span>
            <span style={{
              padding: '4px 9px', borderRadius: 999,
              fontSize: 11, fontWeight: 700,
              background: 'rgba(0,0,0,0.55)', color: '#FFD166',
              border: '0.5px solid rgba(255,255,255,0.25)',
              backdropFilter: 'blur(8px)',
              display: 'inline-flex', alignItems: 'center', gap: 4,
            }}>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="#FFD166"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.5l7.1-.6z"/></svg>
              {movie.rating.toFixed(1)}
            </span>
          </div>
          {/* title overlay */}
          <div style={{ position: 'absolute', left: 22, right: 22, bottom: 16 }}>
            <div style={{
              fontFamily: '"Space Grotesk"', fontSize: 30, fontWeight: 800,
              color: '#fff', letterSpacing: -0.8, lineHeight: 1.05,
            }}>{movie.title}</div>
            <div style={{
              display: 'flex', gap: 10, alignItems: 'center', marginTop: 6,
              color: 'rgba(255,255,255,0.75)', fontSize: 12, fontWeight: 600,
            }}>
              <span>{movie.year}</span>
              <span style={{ width: 3, height: 3, borderRadius: 999, background: 'rgba(255,255,255,0.5)' }}/>
              <span>{movie.runtime}</span>
              <span style={{ width: 3, height: 3, borderRadius: 999, background: 'rgba(255,255,255,0.5)' }}/>
              <span>{movie.platform}</span>
            </div>
          </div>
        </div>

        {/* scrollable body */}
        <div style={{ flex: 1, overflowY: 'auto', padding: '18px 22px 16px' }}>
          {/* genre chips */}
          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 16 }}>
            {movie.genres.map(g => (
              <span key={g} style={{
                fontSize: 11, fontWeight: 700, letterSpacing: 0.6,
