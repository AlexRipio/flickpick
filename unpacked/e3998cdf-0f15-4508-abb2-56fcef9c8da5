// Swipe screen + Match screen + Filters sheet + History + Profile

function SwipeScreen({ room, onBack, onMatch, onOpenFilters, onOpenHistory, queue, setQueue, matches, filters }) {
  const [dragOffset, setDragOffset] = React.useState({ x: 0, y: 0 });
  const [dragging, setDragging] = React.useState(false);
  const [exitDir, setExitDir] = React.useState(null);
  const [detailMovie, setDetailMovie] = React.useState(null);
  const startRef = React.useRef(null);
  const startTimeRef = React.useRef(0);
  const cardRef = React.useRef(null);

  // Filtered queue
  const filtered = React.useMemo(() => {
    return queue.filter(m => {
      if (filters.type !== 'All' && m.type !== filters.type) return false;
      if (filters.genres.length && !m.genres.some(g => filters.genres.includes(g))) return false;
      if (filters.platforms.length && !filters.platforms.includes(m.platform)) return false;
      if (m.year < filters.yearRange[0] || m.year > filters.yearRange[1]) return false;
      return true;
    });
  }, [queue, filters]);

  const top = filtered[0];
  const next = filtered[1];
  const after = filtered[2];

  const handlePointerDown = (e) => {
    startRef.current = { x: e.clientX, y: e.clientY };
    startTimeRef.current = Date.now();
    setDragging(true);
    e.currentTarget.setPointerCapture(e.pointerId);
  };
  const handlePointerMove = (e) => {
    if (!startRef.current) return;
    setDragOffset({ x: e.clientX - startRef.current.x, y: e.clientY - startRef.current.y });
  };
  const handlePointerUp = () => {
    const { x, y } = dragOffset;
    const dt = Date.now() - startTimeRef.current;
    const dist = Math.hypot(x, y);
    // Tap: short press, minimal movement → open detail
    if (dt < 260 && dist < 8 && top) {
      setDetailMovie(top);
      setDragOffset({ x: 0, y: 0 });
    } else if (x > 90) swipe('right');
    else if (x < -90) swipe('left');
    else { setDragOffset({ x: 0, y: 0 }); }
    setDragging(false);
    startRef.current = null;
  };

  const swipe = (dir) => {
    setExitDir(dir);
    setTimeout(() => {
      if (top && dir === 'right') {
        // Simulate match on ~30% of right swipes
        if (Math.random() < 0.45) onMatch(top);
      }
      setQueue(q => q.filter(m => m.id !== top?.id));
      setExitDir(null);
      setDragOffset({ x: 0, y: 0 });
    }, 320);
  };

  const rotate = dragOffset.x * 0.08;
  const likeOp = Math.min(1, Math.max(0, dragOffset.x / 120));
  const skipOp = Math.min(1, Math.max(0, -dragOffset.x / 120));

  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
      <AmbientBackdrop hue={280}/>
      {/* top bar */}
      <div style={{
        position: 'relative', zIndex: 5,
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        padding: '12px 18px',
      }}>
        <IconButton onClick={onBack} size={40}>
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
            <path d="M9 2L3 7l6 5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </IconButton>
        <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
          <div style={{ fontSize: 10, color: FP.textMuted, letterSpacing: 2, textTransform: 'uppercase' }}>
            Room · {room.code}
          </div>
          <div style={{ display: 'flex', gap: -4, marginTop: 4 }}>
            {room.members.map((m, i) => (
              <div key={i} style={{
                width: 24, height: 24, borderRadius: 999,
                background: m.color, color: '#fff',
                border: '2px solid #0B0618',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                fontSize: 10, fontWeight: 700,
                marginLeft: i === 0 ? 0 : -8,
              }}>{m.avatar}</div>
            ))}
          </div>
        </div>
        <IconButton onClick={onOpenFilters} size={40}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M3 6h18M6 12h12M10 18h4" stroke="#fff" strokeWidth="2" strokeLinecap="round"/>
          </svg>
        </IconButton>
      </div>

      {/* progress */}
      <div style={{ position: 'relative', zIndex: 5, padding: '0 24px', marginBottom: 10 }}>
        <div style={{
          height: 3, borderRadius: 2, background: 'rgba(255,255,255,0.08)',
          overflow: 'hidden',
        }}>
          <div style={{
            height: '100%', width: `${Math.max(5, 100 - (filtered.length / queue.length) * 100)}%`,
            background: FP.flame, borderRadius: 2,
            transition: 'width 0.3s',
          }}/>
        </div>
        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: 6, fontSize: 11, color: FP.textMuted }}>
          <span>{matches.length} matched</span>
          <span>{filtered.length} left</span>
        </div>
      </div>

      {/* card stack */}
      <div style={{
        flex: 1, position: 'relative', padding: '10px 22px 0',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
      }}>
        {!top ? (
          <EmptyQueue onRefresh={onOpenFilters}/>
        ) : (
          <>
            {/* 3rd card peek */}
            {after && (
              <Card movie={after} style={{
                transform: 'scale(0.88) translateY(24px)', opacity: 0.5, zIndex: 1,
              }} showActions={false}/>
            )}
            {next && (
              <Card movie={next} style={{
                transform: 'scale(0.94) translateY(12px)', opacity: 0.85, zIndex: 2,
              }} showActions={false}/>
            )}
            <Card
              ref={cardRef}
              movie={top}
              style={{
                zIndex: 3,
                transform: exitDir
                  ? `translate(${exitDir === 'right' ? 600 : -600}px, ${dragOffset.y}px) rotate(${exitDir === 'right' ? 30 : -30}deg)`
                  : `translate(${dragOffset.x}px, ${dragOffset.y * 0.3}px) rotate(${rotate}deg)`,
                transition: dragging ? 'none' : 'transform 0.32s cubic-bezier(.2,.8,.3,1.2)',
                cursor: dragging ? 'grabbing' : 'grab',
                touchAction: 'none',
              }}
              onPointerDown={handlePointerDown}
              onPointerMove={handlePointerMove}
              onPointerUp={handlePointerUp}
              onPointerCancel={handlePointerUp}
              likeOp={likeOp}
              skipOp={skipOp}
              showActions
            />
          </>
        )}
      </div>

      {/* detail sheet */}
      {detailMovie && (
        <DetailSheet
          movie={detailMovie}
          onClose={() => setDetailMovie(null)}
          onLike={() => { setDetailMovie(null); swipe('right'); }}
          onSkip={() => { setDetailMovie(null); swipe('left'); }}
        />
      )}

      {/* action buttons */}
      {top && (
        <div style={{
          position: 'relative', zIndex: 5, padding: '18px 24px 28px',
          display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 16,
        }}>
          <ActionFAB onClick={() => swipe('left')} variant="skip" size={56}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M6 6l12 12M6 18L18 6" stroke="#fff" strokeWidth="2.5" strokeLinecap="round"/>
            </svg>
          </ActionFAB>
          <ActionFAB onClick={onOpenHistory} variant="neutral" size={46}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M20.8 11a9 9 0 11-2.9-7.6M21 3v5h-5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
            </svg>
          </ActionFAB>
          <ActionFAB onClick={() => swipe('right')} variant="like" size={68}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z" fill="#fff"/>
            </svg>
          </ActionFAB>
          <ActionFAB onClick={() => swipe('right')} variant="boost" size={46}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" fill="#FFB547"/>
            </svg>
          </ActionFAB>
        </div>
      )}
    </div>
  );
}

function ActionFAB({ children, onClick, variant, size }) {
  const bgs = {
    skip:    'linear-gradient(135deg, #2a1f3d, #1a1028)',
    like:    FP.flame,
    neutral: 'rgba(255,255,255,0.06)',
    boost:   'rgba(255,183,71,0.12)',
  };
  const borders = {
    skip:    '1.5px solid rgba(255,255,255,0.1)',
    like:    'none',
    neutral: '1px solid rgba(255,255,255,0.1)',
    boost:   '1px solid rgba(255,183,71,0.35)',
  };
  const shadows = {
    skip:    '0 6px 16px rgba(0,0,0,0.4)',
    like:    '0 10px 28px rgba(255,59,107,0.45)',
    neutral: 'none',
    boost:   '0 4px 12px rgba(255,183,71,0.25)',
  };
  return (
    <button onClick={onClick} style={{
      width: size, height: size, borderRadius: 999,
      background: bgs[variant], border: borders[variant],
      boxShadow: shadows[variant],
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      cursor: 'pointer', color: '#fff',
      transition: 'transform 0.12s',
    }}
    onMouseDown={(e) => e.currentTarget.style.transform = 'scale(0.9)'}
    onMouseUp={(e) => e.currentTarget.style.transform = 'scale(1)'}
    onMouseLeave={(e) => e.currentTarget.style.transform = 'scale(1)'}
    >{children}</button>
  );
}

const Card = React.forwardRef(function Card({ movie, style = {}, likeOp = 0, skipOp = 0, showActions, ...rest }, ref) {
  return (
    <div ref={ref} {...rest} style={{
      position: 'absolute', top: 10, left: 22, right: 22, bottom: 10,
      borderRadius: 28, overflow: 'hidden',
      background: '#1a0f2e',
      boxShadow: '0 30px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.06)',
      ...style,
    }}>
      <Poster movie={movie} showBadge={true}/>
      {/* like/skip stamps */}
      {showActions && likeOp > 0.05 && (
        <div style={{
          position: 'absolute', top: 30, right: 22,
          padding: '6px 14px', borderRadius: 10,
          border: '3px solid #4EFFD6',
          color: '#4EFFD6',
