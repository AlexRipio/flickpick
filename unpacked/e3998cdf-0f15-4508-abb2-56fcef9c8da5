          <div style={{
            fontSize: 14, color: FP.text, lineHeight: 1.55, marginBottom: 20,
          }}>{movie.overview}</div>

          {/* meta grid */}
          <div style={{
            display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10, marginBottom: 20,
          }}>
            {[
              ['Platform', movie.platform],
              ['Runtime', movie.runtime],
              ['Rating', `${movie.rating.toFixed(1)} / 10`],
              ['Released', movie.year],
            ].map(([k, v]) => (
              <div key={k} style={{
