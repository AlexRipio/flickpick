          </svg>
        </IconButton>
        <div style={{ fontSize: 13, fontWeight: 600, color: FP.textDim }}>Match history</div>
        <div style={{ width: 40 }}/>
      </div>
      <div style={{ position: 'relative', zIndex: 2, padding: '20px 24px 0' }}>
        <h1 style={{
          fontFamily: '"Space Grotesk"', fontSize: 30, fontWeight: 800,
          color: FP.text, margin: 0, letterSpacing: -0.8,
        }}>Your matches</h1>
        <div style={{ fontSize: 14, color: FP.textDim, marginTop: 6 }}>
          {matches.length} titles you and your crew agreed on.
        </div>
        <div style={{
          marginTop: 16, padding: 4, borderRadius: 14,
          background: 'rgba(255,255,255,0.05)',
          border: '1px solid rgba(255,255,255,0.08)',
          display: 'flex', gap: 4,
        }}>
          {[['all','All'],['watched','Watched']].map(([k, l]) => (
            <button key={k} onClick={() => setTab(k)} style={{
              flex: 1, height: 36, borderRadius: 10,
              background: tab === k ? FP.flame : 'transparent', border: 'none',
              color: '#fff', fontWeight: 700, fontSize: 13, cursor: 'pointer',
            }}>{l}</button>
          ))}
        </div>
      </div>
      <div style={{ position: 'relative', zIndex: 2, flex: 1, overflowY: 'auto', padding: '18px 24px 40px' }}>
        {filtered.length === 0 ? (
          <div style={{ textAlign: 'center', padding: 40, color: FP.textDim }}>
            No matches yet — start swiping!
          </div>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            {filtered.map(m => (
              <div key={m.id} style={{
                display: 'flex', gap: 14, padding: 10,
                borderRadius: 18,
                background: 'rgba(255,255,255,0.04)',
                border: '1px solid rgba(255,255,255,0.08)',
              }}>
                <div style={{
                  width: 72, height: 100, borderRadius: 12, overflow: 'hidden', position: 'relative', flexShrink: 0,
                }}>
                  <Poster movie={m} showBadge={false}/>
                </div>
                <div style={{ flex: 1, minWidth: 0, paddingTop: 4 }}>
                  <div style={{ fontFamily: '"Space Grotesk"', fontSize: 16, fontWeight: 700, color: FP.text }}>{m.title}</div>
                  <div style={{ fontSize: 12, color: FP.textDim, marginTop: 3 }}>
                    {m.year} · {m.genres[0]} · {m.platform}
                  </div>
                  <div style={{ fontSize: 11, color: FP.textMuted, marginTop: 4 }}>
                    Matched {m.matchedAt || '2h ago'}
                  </div>
                  <div style={{ display: 'flex', gap: 8, marginTop: 8 }}>
                    <button onClick={() => onToggleWatched(m.id)} style={{
                      padding: '6px 10px', borderRadius: 999,
                      background: m.watched ? 'rgba(78,255,214,0.12)' : 'rgba(255,255,255,0.06)',
                      border: `1px solid ${m.watched ? 'rgba(78,255,214,0.35)' : 'rgba(255,255,255,0.1)'}`,
                      color: m.watched ? '#4EFFD6' : FP.textDim,
                      fontSize: 11, fontWeight: 700, cursor: 'pointer',
                      display: 'inline-flex', alignItems: 'center', gap: 5,
                    }}>
                      {m.watched ? '✓ Watched' : 'Mark watched'}
                    </button>
                    <button onClick={() => onRemove(m.id)} style={{
                      padding: '6px 10px', borderRadius: 999,
                      background: 'transparent',
                      border: '1px solid rgba(255,255,255,0.1)',
                      color: FP.textMuted, fontSize: 11, fontWeight: 700, cursor: 'pointer',
                    }}>Remove</button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

