// Auth screens — Splash, Welcome, Sign-in, Onboarding

function SplashScreen({ onDone }) {
  React.useEffect(() => {
    const t = setTimeout(() => onDone(), 1600);
    return () => clearTimeout(t);
  }, []);
  return (
    <div style={{
      position: 'absolute', inset: 0, display: 'flex',
      alignItems: 'center', justifyContent: 'center',
      flexDirection: 'column', gap: 28,
      background: '#07050E',
    }}>
      <AmbientBackdrop hue={320}/>
      <div style={{ position: 'relative', zIndex: 2, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 20 }}>
        <div style={{
          width: 120, height: 120, borderRadius: 32,
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          animation: 'fp-pulse 2s ease-in-out infinite',
        }}>
          <FlameLogoImage size={110}/>
        </div>
        <FlickPickWordmark height={34}/>
        <div style={{ fontSize: 13, color: FP.textDim, letterSpacing: 4, textTransform: 'uppercase' }}>
          Swipe. Match. Watch.
        </div>
      </div>
      <style>{`
        @keyframes fp-pulse {
          0%, 100% { transform: scale(1); }
          50% { transform: scale(1.05); }
        }
      `}</style>
    </div>
  );
}

function WelcomeScreen({ onSignIn, onEmail }) {
  return (
    <div style={{ position: 'absolute', inset: 0, overflow: 'hidden' }}>
      <AmbientBackdrop hue={300}/>
      {/* floating poster collage */}
      <div style={{ position: 'absolute', inset: 0, zIndex: 1 }}>
        {[0, 1, 2, 3, 4].map(i => {
          const movie = FP_MOVIES[(i * 2) % FP_MOVIES.length];
          const positions = [
            { top: '5%',  left: '-10%', rot: -12, scale: 0.55 },
            { top: '2%',  right: '-5%',  rot:  8,  scale: 0.62 },
            { top: '22%', left: '45%',   rot: -5,  scale: 0.5  },
            { top: '32%', left: '5%',    rot:  6,  scale: 0.58 },
            { top: '45%', right: '-12%', rot: 14,  scale: 0.6  },
          ];
          const p = positions[i];
          return (
            <div key={i} style={{
              position: 'absolute', ...p, width: 180, height: 260,
              transform: `rotate(${p.rot}deg) scale(${p.scale})`,
              borderRadius: 22, overflow: 'hidden',
              boxShadow: '0 20px 40px rgba(0,0,0,0.5)',
              opacity: 0.85,
              animation: `fp-float-${i} ${6 + i}s ease-in-out infinite`,
            }}>
              <Poster movie={movie} showBadge={false}/>
            </div>
          );
        })}
      </div>
      {/* fade overlay over posters */}
      <div style={{
        position: 'absolute', inset: 0, zIndex: 2,
        background: 'linear-gradient(180deg, rgba(7,5,14,0.1) 0%, rgba(7,5,14,0.75) 55%, rgba(7,5,14,1) 75%)',
      }}/>
      {/* content */}
      <div style={{
        position: 'absolute', inset: 0, zIndex: 3,
        display: 'flex', flexDirection: 'column',
        padding: '54px 24px 40px', justifyContent: 'space-between',
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, justifyContent: 'center', marginTop: 8 }}>
          <FlameLogoImage size={34}/>
          <FlickPickWordmark height={22}/>
        </div>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 28 }}>
          <div>
            <h1 style={{
              fontFamily: '"Space Grotesk", system-ui',
              fontSize: 44, fontWeight: 800, letterSpacing: -1.5,
              color: FP.text, margin: 0, lineHeight: 1.02,
              textWrap: 'balance',
            }}>
              End the<br/>
              <span style={{
                background: FP.flame,
                WebkitBackgroundClip: 'text',
                WebkitTextFillColor: 'transparent',
              }}>scrolling war.</span>
            </h1>
            <p style={{
              fontSize: 16, color: FP.textDim, margin: '14px 0 0',
              lineHeight: 1.5, maxWidth: 300,
            }}>
              Swipe together. Match instantly. Watch the one you both love.
            </p>
          </div>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            <GradientButton variant="flame" onClick={onEmail}>
              Get started — it's free
            </GradientButton>
            <GradientButton variant="ghost" onClick={onSignIn}>
              <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.7 4.7-6.2 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8c1.8-4.4 6.1-7.5 11.1-7.5 3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.4-4.5 2.3-7.2 2.3-5.1 0-9.4-3.2-11.1-7.8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.1 5.6l6.2 5.2c-.4.4 6.6-4.8 6.6-14.8 0-1.3-.1-2.6-.4-3.9z"/>
              </svg>
              Continue with Google
            </GradientButton>
          </div>
          <div style={{ fontSize: 11, color: FP.textMuted, textAlign: 'center', maxWidth: 280, margin: '0 auto', lineHeight: 1.5 }}>
            By continuing you agree to our Terms of Service and Privacy Policy.
          </div>
        </div>
      </div>
      <style>{`
        @keyframes fp-float-0 { 0%,100% { transform: rotate(-12deg) scale(0.55) translateY(0); } 50% { transform: rotate(-10deg) scale(0.55) translateY(-10px); } }
        @keyframes fp-float-1 { 0%,100% { transform: rotate(8deg) scale(0.62) translateY(0); } 50% { transform: rotate(10deg) scale(0.62) translateY(-8px); } }
        @keyframes fp-float-2 { 0%,100% { transform: rotate(-5deg) scale(0.5) translateY(0); } 50% { transform: rotate(-3deg) scale(0.5) translateY(-12px); } }
        @keyframes fp-float-3 { 0%,100% { transform: rotate(6deg) scale(0.58) translateY(0); } 50% { transform: rotate(8deg) scale(0.58) translateY(-6px); } }
        @keyframes fp-float-4 { 0%,100% { transform: rotate(14deg) scale(0.6) translateY(0); } 50% { transform: rotate(12deg) scale(0.6) translateY(-10px); } }
      `}</style>
    </div>
  );
}

function SignInScreen({ onBack, onComplete, mode = 'signup' }) {
  const [email, setEmail] = React.useState(mode === 'signup' ? '' : 'alex@flickpick.app');
  const [password, setPassword] = React.useState('');
  const [name, setName] = React.useState('');
  const isSignup = mode === 'signup';
  const canSubmit = email.includes('@') && password.length >= 6 && (!isSignup || name.length >= 2);

  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column' }}>
      <AmbientBackdrop hue={280}/>
      <div style={{ position: 'relative', zIndex: 2, padding: '20px 24px 0' }}>
        <IconButton onClick={onBack} size={42}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M9 2L3 7l6 5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
        </IconButton>
      </div>
      <div style={{
        position: 'relative', zIndex: 2,
        padding: '20px 24px', flex: 1,
        display: 'flex', flexDirection: 'column', gap: 24,
      }}>
        <div>
          <h1 style={{
            fontFamily: '"Space Grotesk", system-ui',
            fontSize: 32, fontWeight: 800, color: FP.text,
            margin: 0, letterSpacing: -0.8,
          }}>{isSignup ? 'Create your profile' : 'Welcome back'}</h1>
          <p style={{ fontSize: 15, color: FP.textDim, margin: '8px 0 0' }}>
            {isSignup ? 'Start matching on movies in under a minute.' : 'Sign in to keep the streak going.'}
          </p>
        </div>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
          {isSignup && (
            <TextField label="Username" value={name} onChange={setName} placeholder="@moviepilgrim"/>
          )}
          <TextField label="Email" value={email} onChange={setEmail} type="email" placeholder="you@domain.com"/>
          <TextField label="Password" value={password} onChange={setPassword} type="password" placeholder="At least 6 characters"/>
        </div>
        <div style={{ flex: 1 }}/>
        <GradientButton variant="flame" onClick={canSubmit ? onComplete : undefined} disabled={!canSubmit}>
          {isSignup ? 'Create account' : 'Sign in'}
        </GradientButton>
      </div>
    </div>
  );
}

Object.assign(window, { SplashScreen, WelcomeScreen, SignInScreen });
