function HomeIndicator() {
  return (
    <div style={{
      position: 'absolute', bottom: 8, left: 0, right: 0,
      display: 'flex', justifyContent: 'center', zIndex: 60,
      pointerEvents: 'none',
    }}>
      <div style={{ width: 139, height: 5, borderRadius: 100, background: 'rgba(255,255,255,0.5)' }}/>
    </div>
  );
}

Object.assign(window, {
  GradientButton, IconButton, Chip, TextField, Confetti,
  AmbientBackdrop, StatusBarDark, HomeIndicator,
});
